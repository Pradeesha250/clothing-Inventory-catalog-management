# Server Port (default 8080)
PORT=8080

# MySQL Database Configuration
# Local default: jdbc:mysql://localhost:3306/clothing_inventory?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clothing_inventory?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
