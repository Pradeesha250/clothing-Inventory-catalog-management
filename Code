<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clothing Inventory Management</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #333;
        }

        header {
            background: #222;
            color: white;
            padding: 25px 50px;
        }

        header h1 {
            margin-bottom: 8px;
        }

        nav {
            background: white;
            padding: 15px 50px;
            border-bottom: 1px solid #ddd;
        }

        nav a {
            text-decoration: none;
            color: #333;
            margin-right: 30px;
            font-weight: bold;
        }

        .container {
            padding: 40px 50px;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin: 25px 0 40px;
        }

        .card {
            background: white;
            padding: 25px;
            width: 220px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .card h3 {
            margin-bottom: 15px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .products {
            background: white;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .add-button {
            float: right;
            background: #222;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 5px;
            cursor: pointer;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background: #eee;
        }

        .low-stock {
            color: red;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <header>
        <h1>Clothing Inventory Management System</h1>
        <p>Manage clothing products, variants and stock</p>
    </header>

    <nav>
        <a href="#">Dashboard</a>
        <a href="#">Products</a>
        <a href="#">Inventory</a>
        <a href="#">Orders</a>
        <a href="#">Customers</a>
    </nav>

    <div class="container">

        <h2>Dashboard</h2>

        <div class="cards">

            <div class="card">
                <h3>Total Products</h3>
                <p>3</p>
            </div>

            <div class="card">
                <h3>Total Stock</h3>
                <p>42</p>
            </div>

            <div class="card">
                <h3>Low Stock</h3>
                <p>1</p>
            </div>

        </div>

        <div class="products">

            <h2>
                Products
                <button class="add-button">+ Add Product</button>
            </h2>

            <table>
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Size</th>
                        <th>Colour</th>
                        <th>Stock</th>
                        <th>Price</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Cotton T-Shirt</td>
                        <td>T-Shirt</td>
                        <td>M</td>
                        <td>Black</td>
                        <td>25</td>
                        <td>₹599</td>
                    </tr>

                    <tr>
                        <td>Denim Jeans</td>
                        <td>Jeans</td>
                        <td>32</td>
                        <td>Blue</td>
                        <td>12</td>
                        <td>₹1299</td>
                    </tr>

                    <tr>
                        <td>Casual Shirt</td>
                        <td>Shirt</td>
                        <td>L</td>
                        <td>White</td>
                        <td class="low-stock">5</td>
                        <td>₹899</td>
                    </tr>
                </tbody>
            </table>

        </div>

    </div>

</body>
</html>
